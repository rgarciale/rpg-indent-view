{
  "name": "rpg-indent-view",
  "displayName": "RPG indent view",
  "description": "",
  "version": "1.0.0",
  "publisher": "RamiroGarcia",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgarciale/rpg-indent-view"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openAndReindent",
        "title": "Show RPG Code Indent"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.openAndReindent",
          "when": "editorLangId == 'rpg' || editorLangId == 'rpgle' || editorLangId == 'rpt' ",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@halcyontech/vscode-ibmi-types": "^2.14.5",
    "itoolkit": "^1.0.2"
  }  
}
